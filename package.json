{
  "name": "articleforge",
  "version": "1.0.10",
  "private": true,
  "description": "ArticleForge - 微信/网页文章转 PDF / DOCX / Markdown，带 AI 侧栏、全网检索监控与 Obsidian 知识库沉淀",
  "author": {
    "name": "ArticleForge",
    "email": "articleforge@local"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "app": "electron .",
    "icon": "node scripts/make-icon.mjs",
    "build:win": "electron-builder --win portable",
    "build:dir": "electron-builder --win dir",
    "build:installer": "electron-builder --win nsis",
    "vendor": "node scripts/copy-vendor.mjs",
    "build": "electron-builder --win portable"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "docx": "^9.12.0",
    "express": "^4.19.2",
    "image-size": "^1.2.1",
    "jsdom": "^24.1.3",
    "katex": "^0.16.47",
    "mammoth": "^1.13.0",
    "marked": "^14.1.4",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "^4.10.38",
    "puppeteer-core": "^23.6.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "vditor": "^4.0.1"
  },
  "build": {
    "appId": "com.articleforge.app",
    "productName": "ArticleForge",
    "copyright": "ArticleForge",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "!scripts/**",
      "!release/**",
      "!data/exports/**",
      "!data/cache/**",
      "!**/*.map",
      "!**/*.log",
      "!**/.cache/**",
      "!data/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "ArticleForge-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ArticleForge",
      "artifactName": "ArticleForge-${version}-setup.exe"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ilovezerotwo02/ArticleForge.git"
  }
}
